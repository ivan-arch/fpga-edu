`timescale 1ns/1ps

module moving_max_tb;

    localparam int N = 64;   // N_SAMPLES
    localparam int W = 8;    // WINDOW

    // ---------------- сигнали DUT ----------------
    logic        ap_clk = 0;
    logic        ap_rst = 1;
    logic        ap_start = 0;
    logic        ap_done, ap_idle, ap_ready;

    logic [5:0]  in_data_address0;
    logic        in_data_ce0;
    logic [31:0] in_data_q0;

    logic [5:0]  out_data_address0;
    logic        out_data_ce0, out_data_we0;
    logic [31:0] out_data_d0;

    // ---------------- такт 100 МГц ----------------
    always #5 ap_clk = ~ap_clk;

    // ---------------- DUT ----------------
    // .* з'єднує порти з однойменними сигналами вище
    moving_max_0 dut (.*);

    // ---------------- модель пам'яті ----------------
    logic signed [31:0] mem_in   [N];
    logic signed [31:0] mem_out  [N];   // незаписані комірки лишаться X
    logic signed [31:0] expected [N];

    // вхідна пам'ять: як BRAM, дані на q0 на наступний такт після ce0
    always @(posedge ap_clk)
        if (in_data_ce0)
            in_data_q0 <= mem_in[in_data_address0];

    // вихідна пам'ять: запис при ce0 && we0
    always @(posedge ap_clk)
        if (out_data_ce0 && out_data_we0)
            mem_out[out_data_address0] <= out_data_d0;

    // ---------------- сценарій тесту ----------------
    initial begin
        int errors = 0;

        // 1. випадкові вхідні дані -100..100 та еталон
        for (int n = 0; n < N; n++)
            mem_in[n] = int'($urandom_range(200)) - 100;

        for (int n = 0; n < N; n++) begin
            expected[n] = mem_in[n];
            for (int k = (n >= W-1 ? n-W+1 : 0); k < n; k++)
                if (mem_in[k] > expected[n]) expected[n] = mem_in[k];
        end

        // 2. скидання
        repeat (5) @(posedge ap_clk);
        ap_rst <= 0;
        repeat (2) @(posedge ap_clk);

        // 3. запуск: ap_start тримаємо до ap_ready, потім чекаємо ap_done
        ap_start <= 1;
        @(posedge ap_clk iff ap_ready);
        ap_start <= 0;
        if (!ap_done) @(posedge ap_clk iff ap_done);
        repeat (2) @(posedge ap_clk);

        // 4. перевірка
        for (int n = 0; n < N; n++)
            if (mem_out[n] !== expected[n]) begin
                $display("ERR n=%0d: got %0d, expected %0d", n, mem_out[n], expected[n]);
                errors++;
            end

        if (errors == 0) $display("*** PASS ***");
        else             $display("*** FAIL: %0d errors ***", errors);
        $finish;
    end

    // запобіжник, щоб симуляція не висіла вічно
    initial begin
        #100us;
        $fatal(1, "TIMEOUT: ap_done так і не з'явився");
    end

endmodule