# Зелений світлодіод (LED2) на W13
set_property PACKAGE_PIN W13 [get_ports {led_tri_o[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_tri_o[0]}]

# Червоний світлодіод (LED3) на W14
set_property PACKAGE_PIN W14 [get_ports {led_tri_o[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_tri_o[1]}]